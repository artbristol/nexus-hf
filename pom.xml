<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!--
    The Nexus version this plugin is built against, and the only one it should be installed into: it uses Nexus
    internals, which change between releases. Resolved from Maven Central.
  -->
  <parent>
    <groupId>org.sonatype.nexus.common.components</groupId>
    <artifactId>nexus-common-components-formats-parent</artifactId>
    <version>3.97.2-02</version>
    <relativePath/>
  </parent>

  <groupId>io.github.artbristol</groupId>
  <artifactId>nexus-repository-huggingface</artifactId>
  <version>0.1.0</version>
  <name>Hugging Face proxy for Nexus Repository Core</name>
  <url>https://github.com/artbristol/nexus-hf</url>

  <licenses>
    <license>
      <name>Eclipse Public License 1.0</name>
      <url>https://www.eclipse.org/legal/epl-v10.html</url>
    </license>
  </licenses>

  <build>
    <plugins>
      <!--
        The inherited githook-checks profile points core.hooksPath of the enclosing git repository at Nexus' own
        hooks; that is meant for the nexus-public tree only.
      -->
      <plugin>
        <groupId>com.rudikershaw.gitbuildhook</groupId>
        <artifactId>git-build-hook-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>default</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-plugin-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-repository-content</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-repository-httpbridge</artifactId>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-cleanup</artifactId>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-blobstore-tasks</artifactId>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-testsupport</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
