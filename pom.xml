<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!--
    The Nexus version this plugin is built against, and the only one it should be installed into: it uses Nexus
    internals, which change between releases. Resolved from Maven Central.
  -->
  <parent>
    <groupId>org.sonatype.nexus.common.components</groupId>
    <artifactId>nexus-common-components-formats-parent</artifactId>
    <version>3.97.2-02</version>
    <relativePath/>
  </parent>

  <groupId>io.github.artbristol</groupId>
  <artifactId>nexus-repository-huggingface</artifactId>
  <version>0.1.0</version>
  <name>Hugging Face proxy for Nexus Repository Core</name>
  <url>https://github.com/artbristol/nexus-hf</url>

  <licenses>
    <license>
      <name>Eclipse Public License 1.0</name>
      <url>https://www.eclipse.org/legal/epl-v10.html</url>
    </license>
  </licenses>

  <properties>
    <!--
      The end-to-end suite (e2e/) runs in the integration-test phases, so `mvn verify` runs it and `mvn package` does
      not; -DskipITs skips it. It runs against a Nexus assembled from Maven Central (see e2e/lifecycle.py) and the real
      huggingface.co, and needs Python 3.13.
    -->
    <nexus.version>${project.parent.version}</nexus.version>
    <e2e.home>${project.build.directory}/e2e/nexus-base-overlay-${nexus.version}</e2e.home>
    <e2e.python>python3</e2e.python>
    <skipITs>false</skipITs>
  </properties>

  <build>
    <plugins>
      <!-- a Nexus Repository Core installation: the overlay (bin/, etc/, deploy/) and the server jar in bin/ -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>e2e-nexus</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <skip>${skipITs}</skip>
              <outputDirectory>${project.build.directory}/e2e</outputDirectory>
              <artifactItems>
                <artifactItem>
                  <groupId>org.sonatype.nexus.common.assemblies</groupId>
                  <artifactId>nexus-base-overlay</artifactId>
                  <version>${nexus.version}</version>
                  <type>zip</type>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <id>e2e-nexus-jar</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <skip>${skipITs}</skip>
              <outputDirectory>${e2e.home}/bin</outputDirectory>
              <artifactItems>
                <artifactItem>
                  <groupId>org.sonatype.nexus.selfhosted.assemblies</groupId>
                  <artifactId>nexus-repository-core</artifactId>
                  <version>${nexus.version}</version>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <skip>${skipITs}</skip>
          <executable>${e2e.python}</executable>
          <workingDirectory>${project.basedir}</workingDirectory>
        </configuration>
        <executions>
          <execution>
            <id>e2e-start</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>e2e/lifecycle.py</argument>
                <argument>start</argument>
                <argument>--home=${e2e.home}</argument>
                <argument>--plugin=${project.build.directory}/${project.build.finalName}.jar</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-test</id>
            <phase>integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>e2e/lifecycle.py</argument>
                <argument>test</argument>
                <argument>--home=${e2e.home}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-stop</id>
            <phase>post-integration-test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>e2e/lifecycle.py</argument>
                <argument>stop</argument>
                <argument>--home=${e2e.home}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>e2e-verify</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>e2e/lifecycle.py</argument>
                <argument>verify</argument>
                <argument>--home=${e2e.home}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        The inherited githook-checks profile points core.hooksPath of the enclosing git repository at Nexus' own
        hooks; that is meant for the nexus-public tree only.
      -->
      <plugin>
        <groupId>com.rudikershaw.gitbuildhook</groupId>
        <artifactId>git-build-hook-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>default</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      `mvn -Pgithub-release deploy`: builds, runs all tests, then creates the GitHub release v<version>, and its tag at the
      commit built (which must be pushed), with the jar. With a jar already built and tested in target/,
      `mvn -Pgithub-release initialize exec:exec@github-release` just releases it. Uses the GitHub CLI, gh, logged in or with a
      token in GH_TOKEN; -Drelease.gh=echo shows the command instead.
    -->
    <profile>
      <id>github-release</id>
      <properties>
        <!-- nothing goes to a Maven repository -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <release.gh>gh</release.gh>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>github-release</id>
                <phase>deploy</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>false</skip>
                  <executable>${release.gh}</executable>
                  <arguments>
                    <argument>release</argument>
                    <argument>create</argument>
                    <argument>v${project.version}</argument>
                    <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                    <argument>--target=${build.revision}</argument>
                    <argument>--title=v${project.version} for Nexus Repository Core ${nexus.version}</argument>
                    <argument>--notes-file=src/release/notes.md</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-plugin-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-repository-content</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-repository-httpbridge</artifactId>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-cleanup</artifactId>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-blobstore-tasks</artifactId>
    </dependency>

    <dependency>
      <groupId>org.sonatype.nexus.common.components</groupId>
      <artifactId>nexus-testsupport</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
